# Example environment file for the E2E MQTT test (test_e2e.py).
#
# Copy this file to ".env" in this same folder and fill in your values.
# ".env" is git-ignored: never commit it.
#
# test_e2e.py loads ".env" from its own directory; any variable already set in the
# shell environment wins over the file. The same values can be passed as --broker,
# --user, --password, --port, --device on the command line.

# MQTT broker (e.g. a HiveMQ Cloud cluster; TLS on 8883)
MQTT_SERVER=your-cluster-id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your_mqtt_user
MQTT_PASS=your_mqtt_password

# Device under test: f1 or f2
MQTT_DEVICE_ID=f1

# --- Other secret files in this repository (they are NOT read from .env) --------
# Firmware:        firmware/fermentatore_v6/fermentatore_v6/secrets.h            <- secrets.h.template
# Home Assistant:  homeassistant/secrets.yaml                                     <- secrets.yaml.template
# HA start script: homeassistant/scripts_py/mqtt_broker.json (on the HA host)     <- mqtt_broker.json.template
