# Copia questo file in secrets.yaml (che è ignorato da git) e compila i valori.
# Su Home Assistant va in /config/secrets.yaml.

# Notifiche e-mail (notify.fermentazione_email)
smtp_server: smtp.example.com
smtp_port: 587
smtp_username: ''
smtp_password: ''
smtp_sender: home-assistant@example.com
smtp_recipient: you@example.com

# InfluxDB (opzionale, usato da influxdb.yaml)
influxdb_host: 192.168.1.10
influxdb_username: homeassistant
influxdb_password: change_me
